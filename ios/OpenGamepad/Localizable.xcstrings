          }
        }
      }
    },
    "IP:port (e.g. 192.168.1.10:47800)": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "IP:porta (es. 192.168.1.10:47800)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IP:ポート（例：192.168.1.10:47800）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "IP:端口（例如 192.168.1.10:47800）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "IP:連接埠（例如 192.168.1.10:47800）"
          }
        }
      }
    },
    "Needs the companion (Windows, Linux) or the Switch sysmodule on the same Wi‑Fi network.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve il companion (Windows, Linux) o il sysmodule Switch sulla stessa rete Wi‑Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ Wi‑Fi ネットワーク上にコンパニオン（Windows、Linux）または Switch の sysmodule が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要同一 Wi‑Fi 网络上的伴侣程序（Windows、Linux）或 Switch 系统模块。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要同一 Wi‑Fi 網路上的伴侶程式（Windows、Linux）或 Switch 系統模組。"
          }
        }
      }
    },
    "OLED black": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nero OLED"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OLED ブラック"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OLED 纯黑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OLED 純黑"
          }
        }
      }
    },
    "OLED black uses pure black: on OLED screens black pixels stay off.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nero OLED usa il nero puro: sugli schermi OLED i pixel neri restano spenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OLED ブラックは純黒を使用：OLED 画面では黒いピクセルが消灯します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OLED 纯黑使用纯黑色：在 OLED 屏幕上黑色像素保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OLED 純黑使用純黑色：在 OLED 螢幕上黑色像素保持關閉。"
          }
        }
      }
    },
    "Scan the companion's QR code with the Camera, search the network or type the address.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadra il codice QR del companion con la Fotocamera, cerca nella rete o scrivi l'indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラでコンパニオンの QR コードを読み取るか、ネットワークを検索するか、アドレスを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用相机扫描伴侣程序的二维码、在网络中搜索，或输入地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用相機掃描伴侶程式的 QR 碼、在網路中搜尋，或輸入位址。"
          }
        }
      }
    },
