<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>opengamepad-companion</AssemblyName>
    <RootNamespace>OpenGamepad.Companion</RootNamespace>
    <Version>1.1.0</Version>
    <Product>OpenGamepad Companion</Product>
    <Description>Turns the OpenGamepad Android app into a virtual Xbox 360 controller on Linux (uinput).</Description>
    <Copyright>OpenGamepad contributors · MIT License</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" />
    <None Include="70-opengamepad-uinput.rules" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
